#!/usr/bin/make -f
# Plain file installation (no setuptools needed, so it builds on older releases too).
PKG := debian/k7ctl

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	QT_QPA_PLATFORM=offscreen python3 -m pytest -q -p no:cacheprovider tests
endif

override_dh_auto_install:
	install -d $(PKG)/usr/lib/python3/dist-packages $(PKG)/usr/bin
	cp -r k7ctl $(PKG)/usr/lib/python3/dist-packages/
	find $(PKG) -name __pycache__ -prune -exec rm -rf {} +
	printf '#!/usr/bin/python3\nimport sys\nfrom k7ctl.cli import main\nsys.exit(main())\n' > $(PKG)/usr/bin/k7ctl
	chmod 755 $(PKG)/usr/bin/k7ctl
	./install-files.sh $(PKG)
	# Debian keeps the license as /usr/share/doc/k7ctl/copyright
	rm -rf $(PKG)/usr/share/licenses

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
