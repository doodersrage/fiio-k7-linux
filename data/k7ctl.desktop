[Desktop Entry]
Type=Application
Name=FiiO K7
GenericName=DAC settings
Comment=FiiO K7 status, bit-perfect playback settings and headphone EQ
Exec=k7ctl gui
Icon=audio-card
Terminal=false
Categories=AudioVideo;Audio;Mixer;
Keywords=fiio;k7;dac;sample rate;bit-perfect;eq;equalizer;autoeq;headphones;
StartupNotify=true
Actions=status;eq-toggle;setup;tray;

[Desktop Action status]
Name=What's playing?
Exec=k7ctl --notify status

[Desktop Action eq-toggle]
Name=Headphone EQ on/off
Exec=k7ctl --notify eq toggle

[Desktop Action setup]
Name=Bit-perfect setup
Exec=k7ctl --notify setup

[Desktop Action tray]
Name=Show tray icon
Exec=k7ctl tray
