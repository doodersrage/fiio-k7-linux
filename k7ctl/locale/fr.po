#: k7ctl/window.py:195
msgid "Otherwise PipeWire resamples everything to 48 kHz. It can only switch when nothing else is playing at another rate."
msgstr "Sinon, PipeWire rééchantillonne tout en 48 kHz. Il ne peut changer que si rien d’autre ne joue à une autre fréquence."

#: k7ctl/window.py:200
msgid "Set to 100%"
msgstr "Mettre à 100 %"

#: k7ctl/window.py:205
msgid "PipeWire volume:"
msgstr "Volume PipeWire :"

#: k7ctl/window.py:206
msgid "The K7 has no volume control over USB, so this is software volume: below 100% it reduces resolution. Use the K7's knob instead."
msgstr "Le K7 n’a pas de réglage de volume par USB : il s’agit donc d’un volume logiciel, qui réduit la résolution en dessous de 100 %. Utilisez plutôt la molette du K7."

#: k7ctl/window.py:211
msgid "Make the K7 the default"
msgstr "Faire du K7 la sortie par défaut"

#: k7ctl/window.py:216
msgid "Default output:"
msgstr "Sortie par défaut :"

